# Variables utilisees par docker-compose.yml
# Copier ce fichier en .env puis adapter les valeurs.

# Base de donnees (service db)
DB_PASSWORD=change_me

# JWT (minimum 32 caracteres)
JWT_SECRET=changez_moi_32_caracteres_minimum_xx
JWT_REFRESH_SECRET=changez_moi_32_caracteres_minimum_xx

# URL de l'API utilisee par le frontend (navigateur)
VITE_API_URL=http://localhost:3000/api

# Origines autorisees en CORS pour l'API
CORS_ORIGINS=http://localhost:5173

# Envoi d'e-mails : noop (journalise) ou smtp
MAIL_MODE=noop
FRONTEND_URL=http://localhost:5173
