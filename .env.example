# Variables utilisees par docker-compose.yml
# Copier ce fichier en .env puis adapter les valeurs.

# Base de donnees (service db)
DB_PASSWORD=change_me

# JWT (minimum 32 caracteres)
JWT_SECRET=changez_moi_32_caracteres_minimum_xx
JWT_REFRESH_SECRET=changez_moi_32_caracteres_minimum_xx

# URL publique de l'API utilisee par le navigateur. Avec docker-compose, Vite
# relaie /api vers le service backend, sans exposer un localhost côté client.
VITE_API_URL=/api

# Origines autorisees en CORS pour l'API
CORS_ORIGINS=http://localhost:5173

# Envoi d'e-mails : noop (journalise le lien dans les logs du backend) ou smtp
MAIL_MODE=noop

# Parametres SMTP : requis uniquement si MAIL_MODE=smtp.
# Le port 465 active le TLS implicite, le port 587 utilise STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plateforme Fianarantsoa <noreply@univ-fianarantsoa.mg>"

FRONTEND_URL=http://localhost:5173

# Duree de validite du lien de reinitialisation de mot de passe (minutes)
MOT_DE_PASSE_RESET_EXPIRATION_MINUTES=30

# Fuseau de reference pour les regles de dates (date de debut non passee)
TZ_APPLICATION=Indian/Antananarivo
