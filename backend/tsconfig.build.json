{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Le fichier d'informations incrementales vit dans dist/ : ainsi
    // `deleteOutDir` (nest-cli.json) le supprime en meme temps que la sortie.
    // Sinon tsc croit que la compilation est deja faite et n'emet rien
    // (dist absent, `nest build` sortant pourtant en code 0).
    "tsBuildInfoFile": "./dist/tsconfig.build.tsbuildinfo"
  },
  "exclude": ["node_modules", "test", "dist", "**/*spec.ts", "scripts", "prisma"]
}
