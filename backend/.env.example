# Base de donnees
DATABASE_URL=postgresql://postgres:change_me@localhost:5432/plateforme_partenariat?schema=public
DB_PASSWORD=change_me

# JWT (minimum 32 caracteres)
JWT_SECRET=change_me_32_characters_min
JWT_REFRESH_SECRET=change_me_32_characters_min

# Backend
PORT=3000
NODE_ENV=development

# Origines autorisees en CORS (separees par des virgules)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Envoi d'e-mails : noop (journalisation) ou smtp
MAIL_MODE=noop
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Plateforme Fianarantsoa <noreply@univ-fianarantsoa.mg>"
FRONTEND_URL=http://localhost:5173
MOT_DE_PASSE_RESET_EXPIRATION_MINUTES=30
